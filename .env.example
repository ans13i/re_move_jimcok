# 이 파일을 .env.local로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env.local
#
# .env.local은 .gitignore에 걸려 있어 커밋되지 않습니다.
# 이 파일(.env.example)에는 절대 실제 키를 적지 마세요.

# ─────────────────────────────────────────────
# 필수
# ─────────────────────────────────────────────

# Anthropic Console에서 발급: https://console.anthropic.com/settings/keys
# 서버리스 함수(api/)에서만 읽습니다. 브라우저로는 절대 나가지 않습니다.
# ⚠️ VITE_ 접두사를 붙이지 마세요 — 붙이면 Vite가 클라이언트 번들에 넣어버립니다.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# 선택
# ─────────────────────────────────────────────

# 사용할 모델. 비우면 claude-opus-5를 씁니다.
# CLAUDE_MODEL=claude-opus-5

# 추론 강도: low | medium | high | xhigh | max. 비우면 medium.
# 배치는 제약을 코드가 잡아주므로 medium이면 충분하고, 응답도 빠릅니다.
# CLAUDE_EFFORT=medium
