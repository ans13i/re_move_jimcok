# ─────────────────────────────────────────────
# 의존성
# ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────────────────────────────────────
# 환경 변수 — 실제 키는 절대 커밋하지 않습니다
# ─────────────────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# 단, 빈 템플릿은 팀원 공유를 위해 커밋합니다
!.env.example

# ─────────────────────────────────────────────
# 빌드 산출물
# ─────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Vercel
# ─────────────────────────────────────────────
.vercel

# ─────────────────────────────────────────────
# 로그 / 캐시
# ─────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
.vite/

# ─────────────────────────────────────────────
# 에디터 / OS
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# ─────────────────────────────────────────────
# 이전 Cloudflare 스캐폴드 백업 (Vercel 전환 시 보관)
# ─────────────────────────────────────────────
_legacy-cloudflare/

.vercel

# .env*는 위에서 이미 처리했습니다 (.env.example은 커밋 대상)
!.env.example
